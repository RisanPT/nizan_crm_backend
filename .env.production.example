NODE_ENV=production
PORT=5001
MONGO_URI=your_production_mongo_uri
JWT_SECRET=your_production_jwt_secret
FRONTEND_ORIGINS=https://app.example.com,https://www.example.com,https://example.netlify.app
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Nizan
ADMIN_ROLE=admin
COMPANY_NAME=Nizan Makeovers

# TeamN Chat (WhatsApp) — CRM app connection key (starts with tnm_). Server only,
# never in the Flutter app. Created by the TeamN Chat admin.
TEAMN_CHAT_KEY=
# TEAMN_CHAT_URL=https://chat.nizantech.com

# OpenRouteService (road distance from HQ) — free key from openrouteservice.org.
# Server only. HQ defaults to HiLITE Business Park, Kozhikode.
ORS_API_KEY=
# HQ_LAT=11.2483
# HQ_LNG=75.834
# HQ_LABEL=HiLITE Business Park, Kozhikode

# In-app help assistant (optional). Without a key it falls back to plain manual search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
